variable        vy   equal 2.0*370.697432030705/sqrt(14.0)
variable        vz   equal 3.0*${vpka}/sqrt(14.0)
variable        vz   equal 3.0*370.697432030705/sqrt(14.0)
velocity        pka set ${vx} ${vy} ${vz} sum yes units box
velocity        pka set 99.0730560582727 ${vy} ${vz} sum yes units box
